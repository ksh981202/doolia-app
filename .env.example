# Supabase (Project Settings → API)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key

# Cloudflare R2 public asset host (custom domain or r2.dev)
VITE_R2_PUBLIC_BASE_URL=https://files.doolia.example

# Server-only R2 API (do not prefix with VITE_ — never expose secrets to the browser)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=doolia-assets
R2_PUBLIC_BASE_URL=https://files.doolia.example

# Admin panel: server-only PIN + HMAC cookie (do not prefix ADMIN_API_SECRET with VITE_)
ADMIN_PIN=doolia
ADMIN_API_SECRET=replace-with-a-long-random-string
VITE_ADMIN_PIN=doolia

# Server-only Supabase admin writes (do not prefix with VITE_)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_never_commit_this
