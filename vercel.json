{
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/printable/:slug",
      "has": [
        {
          "type": "query",
          "key": "lang"
        }
      ],
      "destination": "/api/og-printable?slug=:slug"
    },
    { "source": "/printable/:slug", "destination": "/printable/:slug/index.html" },
    { "source": "/((?!api/|printable/|robots\\.txt|sitemap\\.xml).*)", "destination": "/index.html" }
  ]
}
